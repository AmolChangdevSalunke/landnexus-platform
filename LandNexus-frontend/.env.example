# Backend API base URL. Use the Vite dev origin http://localhost:5173 in the browser.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Optional display name used by the UI shell.
VITE_APP_NAME=LandNexus

# Frontend log level: debug | info | warn | error. Defaults to debug in development and warn in production.
# VITE_LOG_LEVEL=debug
