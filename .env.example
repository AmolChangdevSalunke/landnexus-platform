# Copy these names into your own environment (or your IDE run configuration). NEVER commit real values.
DB_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-characters
LANDNEXUS_ADMIN_USERNAME=admin
LANDNEXUS_ADMIN_PASSWORD=choose-a-strong-password-and-do-not-share-it
LANDNEXUS_STORAGE_DIR=D:\landnexus-data\files
# optional
CORS_ALLOWED_ORIGINS=http://localhost:5173
LANDNEXUS_SLA_SCHEDULER=false
# external notifications: providers are none|log|http; none is the default and keeps everything in-app only
LANDNEXUS_NOTIFICATIONS_EMAIL_PROVIDER=none
LANDNEXUS_NOTIFICATIONS_EMAIL_FROM=no-reply@landnexus.local
# LANDNEXUS_NOTIFICATIONS_EMAIL_WEBHOOK_URL=
# LANDNEXUS_NOTIFICATIONS_EMAIL_TOKEN=
LANDNEXUS_NOTIFICATIONS_SMS_PROVIDER=none
LANDNEXUS_NOTIFICATIONS_SMS_SENDER=LANDNEXUS
# LANDNEXUS_NOTIFICATIONS_SMS_WEBHOOK_URL=
# LANDNEXUS_NOTIFICATIONS_SMS_TOKEN=
